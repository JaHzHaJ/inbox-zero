# =============================================================================
# Gabarit du fichier .env de " Gestion Mails " pour une NOUVELLE organisation.
# Rempli par configurer-services.ps1 : les marqueurs en doubles accolades
# sont substitues par les valeurs saisies ou generees.
# CE GABARIT ne contient aucun secret ; le fichier PRODUIT en contient --
# ne jamais le committer, le versionner ni le diffuser.
# Ecrit en disposition " partage actif " ; l'assistant inverse les marqueurs
# # MODE-LOCAL et retire les lignes partage quand le mode local est choisi.
# =============================================================================

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Base de donnees : Supabase (mode partage). Lignes MODE-LOCAL = bascule Docker ---
# MODE-LOCAL DATABASE_URL="postgresql://postgres:password@localhost:5432/inboxzero?schema=public"
DATABASE_URL={{SUPABASE_DATABASE_URL}}
# MODE-LOCAL DIRECT_URL="postgresql://postgres:password@localhost:5432/inboxzero?schema=public"
DIRECT_URL={{SUPABASE_DIRECT_URL}}

# --- Redis : Upstash (mode partage). Lignes MODE-LOCAL = bascule Docker ---
# MODE-LOCAL UPSTASH_REDIS_URL="http://localhost:8079"
UPSTASH_REDIS_URL={{UPSTASH_REDIS_URL}}
# MODE-LOCAL UPSTASH_REDIS_TOKEN={{SRH_TOKEN_LOCAL}}
UPSTASH_REDIS_TOKEN={{UPSTASH_REDIS_TOKEN}}

# --- Secrets internes : generes par l'assistant, propres a CETTE organisation ---
AUTH_SECRET={{AUTH_SECRET}}
EMAIL_ENCRYPT_SECRET={{EMAIL_ENCRYPT_SECRET}}
EMAIL_ENCRYPT_SALT={{EMAIL_ENCRYPT_SALT}}
INTERNAL_API_KEY={{INTERNAL_API_KEY}}
API_KEY_SALT={{API_KEY_SALT}}
CRON_SECRET={{CRON_SECRET}}

# --- Self-host : leve les verrous premium + expose l'action DIGEST dans les regles ---
NEXT_PUBLIC_BYPASS_PREMIUM_CHECKS=true
NEXT_PUBLIC_DIGEST_ENABLED=true

# --- IA : provider CLI claude-code par defaut (abonnement Claude, aucune cle API).
# Le choix reel se fait a l'installation (configurer-ia) et s'ecrit dans .env.local.
CLI_LLM_ENABLED=true
DEFAULT_LLMS=claude-code:sonnet
ECONOMY_LLMS=claude-code:haiku
LLM_API_KEY=

# --- Google : exige par le schema de configuration meme pour une boite Microsoft.
# Valeurs factices de l'emulateur local : rien ne sort du poste.
GOOGLE_CLIENT_ID=emulate-google-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=emulate-google-secret
GOOGLE_BASE_URL=http://localhost:4002
GOOGLE_PUBSUB_TOPIC_NAME="projects/abc/topics/xyz"
GOOGLE_PUBSUB_VERIFICATION_TOKEN={{GOOGLE_PUBSUB_VERIFICATION_TOKEN}}

# --- Microsoft : application Azure AD de VOTRE organisation ---
# MICROSOFT_BASE_URL=http://localhost:4003
MICROSOFT_CLIENT_ID={{MICROSOFT_CLIENT_ID}}
MICROSOFT_CLIENT_SECRET={{MICROSOFT_CLIENT_SECRET}}
MICROSOFT_WEBHOOK_CLIENT_STATE={{MICROSOFT_WEBHOOK_CLIENT_STATE}}
MICROSOFT_TENANT_ID={{MICROSOFT_TENANT_ID}}

# --- Digest ---
DIGEST_MAX_SUMMARIES_PER_24H=100

# --- Resend : envoi du recap par mail ---
RESEND_API_KEY={{RESEND_API_KEY}}
NEXT_PUBLIC_IS_RESEND_CONFIGURED=true
RESEND_FROM_EMAIL={{RESEND_FROM_EMAIL}}
